# ---------------------------------------------------------------------------
# ProspectForge — environment variables. Copy to .env and fill in.
# Secrets entered from Settings are stored encrypted in DB with APP_ENCRYPTION_KEY;
# Service keys and connection values saved in Settings override these defaults.
# Use the in-app "Utiliser .env" action to inherit an environment key again.
# ---------------------------------------------------------------------------

# PostgreSQL (local, Docker, or Supabase "Session pooler" / direct connection string)
DATABASE_URL=postgres://pf:pf@localhost:5432/prospectforge

# Public base URL of the dashboard (used for preview & unsubscribe links)
APP_BASE_URL=http://localhost:3000

# Single administrator. Generate the hash with: npm run hash-password -- 'your-password'
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=
APP_ENCRYPTION_KEY=

# Where screenshots, exports and imports are stored (local disk)
STORAGE_DIR=./storage

# --- AI via your SUBSCRIPTION (no API key): choose "Claude — abonnement" or "ChatGPT — abonnement"
# in Settings → IA. The worker runs the official CLI, logged in on the same machine:
#   claude auth login      (Claude Pro / Max)
#   codex login            (ChatGPT Plus / Pro)
# Optional explicit paths if the CLIs are not on the worker's PATH:
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=

# --- AI providers with API keys (optional, pay-as-you-go)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Data sources
# Overture release; leave empty to auto-detect the latest from the public S3 bucket
OVERTURE_RELEASE=
# INSEE Sirene API key (optional; the free "recherche-entreprises" API needs no key)
INSEE_SIRENE_API_KEY=
# Google Places (optional, Places API New). Respect Google's ToS: no permanent storage.
GOOGLE_PLACES_API_KEY=
# Overpass endpoint (OpenStreetMap). Use your own instance for heavy usage.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Contact sent in User-Agent for OSM/Nominatim/crawling politeness
CRAWLER_CONTACT=admin@example.com

# --- Email
# EMAIL_PROVIDER: sandbox | resend | smtp   (sandbox never sends anything)
EMAIL_PROVIDER=sandbox
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Inbound replies via IMAP polling (optional)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
# Shared secret for the generic inbound webhook (/api/webhooks/inbound)
INBOUND_WEBHOOK_SECRET=

# --- Worker
WORKER_CONCURRENCY=2

# Stripe : clés de test pour commencer, jamais dans le navigateur
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paire de test séparée : le relais local ne remplace jamais les clés réelles
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Hébergement des sites clients : réglages/prix dans Paramètres → Hébergement
O2SWITCH_FTP_PASSWORD=
O2SWITCH_CPANEL_TOKEN=
